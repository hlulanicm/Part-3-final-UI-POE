@model List<MyResultItem>
    @{
    ViewData["Title"] = "My Results";
    }

    <h2 class="rd-title">My results</h2>

    @if (Model.Count == 0)
{
    <div class="card rd-card p-4 text-center text-muted">
        No results yet. Results appear here after an Organiser records them for an event you enrolled in.
    </div>
}
else
{
    <div class="card rd-card">
        <div class="table-responsive">
            <table class="table rd-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Event</th>
                        <th>Date</th>
                        <th>Category</th>
                        <th>Finish time</th>
                        <th>Position</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                    <tr>
                        <td><strong>@r.EventName</strong></td>
                        <td>@Fmt.Date(r.EventDate)</td>
                        <td>@r.CategoryName</td>
                        <td>@Fmt.Time(r.FinishTime)</td>
                        <td>
                            @if (r.Position.HasValue)
                                {
                            @* Example: 47th out of 312 finishers *@
                            <span>@Fmt.Ordinal(r.Position.Value) out of @r.TotalFinishers finishers</span>
                                }
                                else
                                {
                            <span>-</span>
                                }
                        </td>
                    </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
