@* Used for both creating and editing an event *@
@model EventVm
@{
    var editing = Model.EventID > 0;
    ViewData["Title"] = editing ? "Edit event" : "Create event";
}

<h2 class="rd-title">@ViewData["Title"]</h2>

<div class="card rd-card p-4">
    <form asp-action="@(editing ? "EditEvent" : "CreateEvent")" asp-route-id="@(editing ? Model.EventID.ToString() : null)"
          method="post" enctype="multipart/form-data" novalidate>
        <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
        <input asp-for="BannerUrl" type="hidden" />
        <div class="row">
            <div class="col-md-8 mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="EventType" class="form-label"></label>
                <select asp-for="EventType" class="form-select">
                    @foreach (var type in Lookups.EventTypes)
                    {
                    <option value="@type">@type</option>
                    }
                </select>
                <span asp-validation-for="EventType" class="text-danger"></span>
            </div>
        </div>
        <div class="mb-3">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>
        <div class="row">
            <div class="col-md-3 mb-3">
                <label asp-for="EventDate" class="form-label"></label>
                <input asp-for="EventDate" type="date" class="form-control" value="@(Model.EventDate?.ToString("yyyy-MM-dd"))" />
                <span asp-validation-for="EventDate" class="text-danger"></span>
            </div>
            <div class="col-md-5 mb-3">
                <label asp-for="Location" class="form-label"></label>
                <input asp-for="Location" class="form-control" />
                <span asp-validation-for="Location" class="text-danger"></span>
            </div>
            <div class="col-md-2 mb-3">
                <label asp-for="Distance" class="form-label"></label>
                <input asp-for="Distance" class="form-control" type="number" step="0.1" />
                <span asp-validation-for="Distance" class="text-danger"></span>
            </div>
            <div class="col-md-2 mb-3">
                <label asp-for="TargetAudience" class="form-label"></label>
                <input asp-for="TargetAudience" class="form-control" />
                <span asp-validation-for="TargetAudience" class="text-danger"></span>
            </div>
        </div>
        <div class="mb-3">
            <label asp-for="Banner" class="form-label"></label>
            @if (!string.IsNullOrEmpty(Model.BannerUrl))
            {
            <div class="mb-2"><img src="@Model.BannerUrl" alt="Current banner" class="rd-banner" style="max-width: 320px; border-radius: 0.5rem;" /></div>
            }
            <input asp-for="Banner" type="file" class="form-control" accept="image/*" />
            <span asp-validation-for="Banner" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary">@(editing ? "Save changes" : "Create event")</button>
        <a class="btn btn-outline-secondary" asp-action="Events">Cancel</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
