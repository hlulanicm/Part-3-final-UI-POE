@model CategoriesVm
@{
    ViewData["Title"] = "Categories";
}

<div class="mb-3"><a asp-action="Events">&larr; Back to my events</a></div>
<h2 class="rd-title">Categories for @Model.Event.Name</h2>

<div class="row g-4">
    <div class="col-lg-7">
        @if (Model.Categories.Count == 0)
        {
        <div class="card rd-card p-4 text-center text-muted">No categories yet. Add one using the form.</div>
        }
        else
        {
        <div class="card rd-card">
            <div class="table-responsive">
                <table class="table rd-table align-middle mb-0">
                    <thead>
                        <tr><th>Name</th><th>Type</th><th>Distance</th><th>Places</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model.Categories)
                            {
                        <tr>
                            <td><strong>@c.Name</strong><br /><small class="text-muted">@c.Description</small></td>
                            <td>@c.CategoryType</td>
                            <td>@(c.Distance.HasValue ? c.Distance.Value.ToString("0.##") + " km" : "-")</td>
                            <td>@c.MaxParticipants</td>
                            <td class="text-end">
                                <form asp-action="DeleteCategory" method="post" onsubmit="return confirm('Delete this category?');">
                                    <input type="hidden" name="eventId" value="@Model.Event.EventID" />
                                    <input type="hidden" name="categoryId" value="@c.CategoryID" />
                                    <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                                </form>
                            </td>
                        </tr>
                            }
                    </tbody>
                </table>
            </div>
        </div>
        }
    </div>

    <div class="col-lg-5">
        <div class="card rd-card p-4">
            <h4 class="rd-heading">Add a category</h4>
            <form asp-action="AddCategory" method="post" novalidate>
                <input type="hidden" name="eventId" value="@Model.Event.EventID" />
                <div class="mb-3">
                    <label asp-for="Form.CategoryType" class="form-label"></label>
                    <select asp-for="Form.CategoryType" class="form-select">
                        @foreach (var type in Lookups.CategoryTypes)
                        {
                        <option value="@type">@type</option>
                        }
                    </select>
                    <span asp-validation-for="Form.CategoryType" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Form.Name" class="form-label"></label>
                    <input asp-for="Form.Name" class="form-control" placeholder="For example 10 km or Under 20" />
                    <span asp-validation-for="Form.Name" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Form.Description" class="form-label"></label>
                    <input asp-for="Form.Description" class="form-control" />
                    <span asp-validation-for="Form.Description" class="text-danger"></span>
                </div>
                <div class="row">
                    <div class="col-6 mb-3">
                        <label asp-for="Form.Distance" class="form-label"></label>
                        <input asp-for="Form.Distance" type="number" step="0.1" class="form-control" />
                        <span asp-validation-for="Form.Distance" class="text-danger"></span>
                    </div>
                    <div class="col-6 mb-3">
                        <label asp-for="Form.MaxParticipants" class="form-label"></label>
                        <input asp-for="Form.MaxParticipants" type="number" class="form-control" />
                        <span asp-validation-for="Form.MaxParticipants" class="text-danger"></span>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary w-100">Add category</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
