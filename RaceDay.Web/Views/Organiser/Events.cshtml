@model List<OrganiserEventItem>
    @{
    ViewData["Title"] = "My Events";
    }

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="rd-title mb-0">My events</h2>
        <a class="btn btn-primary" asp-action="CreateEvent">Create event</a>
    </div>

    @if (Model.Count == 0)
{
    <div class="card rd-card p-4 text-center text-muted">You have not created any events yet.</div>
}
else
{
    <div class="card rd-card">
        <div class="table-responsive">
            <table class="table rd-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Event</th>
                        <th>Type</th>
                        <th>Date</th>
                        <th>Location</th>
                        <th>Categories</th>
                        <th>Enrolments</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in Model)
                    {
                    <tr>
                        <td><strong>@e.Name</strong></td>
                        <td>@e.EventType</td>
                        <td>@Fmt.Date(e.EventDate)</td>
                        <td>@e.Location</td>
                        <td>@e.CategoryCount</td>
                        <td>@e.EnrollmentCount</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-outline-primary btn-sm" asp-action="Categories" asp-route-eventId="@e.EventID">Categories</a>
                            <a class="btn btn-outline-primary btn-sm" asp-action="Enrolments" asp-route-eventId="@e.EventID">Enrolments</a>
                            <a class="btn btn-outline-primary btn-sm" asp-action="Results" asp-route-eventId="@e.EventID">Results</a>
                            <a class="btn btn-outline-secondary btn-sm" asp-action="EditEvent" asp-route-id="@e.EventID">Edit</a>
                            <form asp-action="DeleteEvent" asp-route-id="@e.EventID" method="post" class="d-inline"
                                  onsubmit="return confirm('Delete this event?');">
                                <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                            </form>
                        </td>
                    </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
